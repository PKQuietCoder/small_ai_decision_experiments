# Environment configuration for Borrowed Intuitions.
#
# Copy this file to `.env` and fill in the values you need. The backend reads it
# through pydantic-settings (see server/app/settings.py). The site serves content
# without any keys; the provider keys are required only to RUN experiments.

# --- Provider API keys (official SDKs, not the Replit AI proxy) ---------------
# Needed by the experiment CLIs (server.run_experiment / export). The site and
# its API run fine without them.
ANTHROPIC_API_KEY=           # required to run Anthropic (Claude) models
OPENAI_API_KEY=              # required to run OpenAI (GPT) models

# --- Web server ---------------------------------------------------------------
# Port the FastAPI backend listens on. Replit assigns PORT automatically.
PORT=8080
# Mount point for the built client (the dev client also requires BASE_PATH).
BASE_PATH=/

# --- Deployment gate ----------------------------------------------------------
# Replit sets REPLIT_DEPLOYMENT=1 in a published deployment and leaves it unset
# in the dev workspace. When it is "1", draft (unpublished) content is never
# served, regardless of ?preview. Leave it unset locally.
# REPLIT_DEPLOYMENT=1
