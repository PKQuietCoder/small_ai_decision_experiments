[
  {
    "name": "set_budget",
    "description": "Record how much you plan to spend on the pen, in dollars, before choosing.",
    "final": false,
    "strict": true,
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "budget": {
          "type": "number",
          "description": "Planned spend in dollars (for example, 1.50)."
        }
      },
      "required": [
        "budget"
      ]
    }
  },
  {
    "name": "inspect_options",
    "description": "Acknowledge that you have reviewed the full list of available pens.",
    "final": false,
    "strict": true,
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reviewed": {
          "type": "boolean",
          "description": "Set to true once you have read the option list."
        }
      },
      "required": [
        "reviewed"
      ]
    }
  },
  {
    "name": "compare_options",
    "description": "Record which pens you are weighing most closely before deciding.",
    "final": false,
    "strict": true,
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "finalists": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "pen_099",
              "pen_199",
              "pen_299",
              "pen_399"
            ]
          },
          "description": "The pen ids you are comparing."
        }
      },
      "required": [
        "finalists"
      ]
    }
  },
  {
    "name": "choose_product",
    "description": "Record the single pen you will buy.",
    "final": true,
    "strict": true,
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "product_id": {
          "type": "string",
          "enum": [
            "pen_099",
            "pen_199",
            "pen_299",
            "pen_399"
          ],
          "description": "The id of the pen to buy."
        }
      },
      "required": [
        "product_id"
      ]
    }
  }
]